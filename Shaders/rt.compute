// rt.compute - Compute shader for ray-traced reflections (BVH per model)
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8,binding=0) readonly uniform image2D inputImage;
layout(rgba8,binding=2) readonly uniform image2D inputSpecular;
layout(rgba8,binding=4) uniform image2D outputImage;
layout(rg16f,binding=5) readonly uniform image2D inputNormal;
layout(location=0) uniform uint screenWidth;
layout(location=1) uniform uint screenHeight;
layout(location=2) uniform int SSR_RES;
layout(location=3) uniform vec3 camPos;
layout(location=4) uniform mat4 viewProjection;
layout(location=5) uniform sampler2D inputDepthID;
layout(location=6) uniform mat4 invViewProj;
layout(location=7) uniform vec2 worldMin;
layout(location=8) uniform uint modelCount;
layout(location=9) uniform uint texCount;
layout(std430,binding=1) readonly buffer ModelMatrices { mat4 modelMatrices[]; };
layout(std430,binding=16) readonly buffer RTGeom { uvec4 rtGeom4[]; };
struct InstanceRTInfo { uvec4 geom; uvec4 info; vec4 iscl2; };
layout(std430,binding=21) readonly buffer RTInstanceInfo { InstanceRTInfo rtInstanceInfo[]; };
layout(std430,binding=23) buffer RTCellCounts { uint rtCellCountsP[]; };
layout(std430,binding=24) buffer RTCellLists { uint rtCellListsP[]; };
layout(std430,binding=15) buffer TextureSizes { ivec2 textureSizes[]; };
struct Light { vec3 pos; float intensity; vec3 col; uint lflags; float range; float spotAng; float maxIntensity; float minIntensity; vec4 spotDir; };
layout(std430,binding=2) buffer VoxelLightListCounts { uint voxelLightListCounts[]; };
layout(std430,binding=3) buffer UniqueLightLists { uint uniqueLightLists[]; };
layout(std430,binding=4) buffer LightIndices { Light lights[]; };
layout(std430,binding=12) buffer ColorBuffer { uint colors[]; };
layout(std430,binding=14) buffer TextureOffsets { uint textureOffsets[]; };
layout(std430,binding=8) buffer TexturePalettes { uint texturePalettes[]; };
layout(std430,binding=9) buffer TexturePaletteOffsets { uint texturePaletteOffsets[]; };
vec3 DecodeOctahedral(vec2 enc) { vec2 encN = enc * 2.0 - 1.0; vec3 n = vec3(encN, 1.0 - abs(encN.x) - abs(encN.y)); n.xy -= max(-n.z, 0.0) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0); return normalize(n); }
vec4 getTextureColor(uint texIdx, ivec2 texCoord, int texSizeX) { uint pixelOffset = textureOffsets[texIdx] + uint(texCoord.y) * texSizeX + uint(texCoord.x); uint slotIndex = pixelOffset >> 2u; uint packedIdx = colors[slotIndex]; return unpackUnorm4x8(texturePalettes[texturePaletteOffsets[texIdx] + ((packedIdx >> ((pixelOffset & 3u) << 3u)) & 0xFFu)]); }
uint GetVoxelIndex(vec3 worldPos) { float offsetX = worldPos.x - worldMin.x; float offsetZ = worldPos.z - worldMin.y; uint voxelX = uint(clamp(offsetX / 0.32, 0.0, 511.0)); uint voxelZ = uint(clamp(offsetZ / 0.32, 0.0, 511.0)); return (voxelZ * 512u) + voxelX; }
vec3 reconstructWorldPos(vec2 uv) { vec3 retval = vec3(0.0); float depth = texture(inputDepthID, uv).r; if (depth < 0.9999) { vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0); vec4 world = invViewProj * clip; retval = world.xyz / world.w; } return retval; }
float rayAABB(vec3 origin, vec3 invDir, vec3 mn, vec3 mx, float maxDist) {
    vec3 t0 = (mn - origin) * invDir; vec3 t1 = (mx - origin) * invDir;
    vec3 tmin = min(t0, t1), tmax = max(t0, t1);
    float tNear = max(max(tmin.x, tmin.y), tmin.z), tFar = min(min(tmax.x, tmax.y), tmax.z);
    if (tFar < max(0.02, tNear) || tNear > maxDist) return -1.0;
    return (tNear >= 0.02) ? tNear : 0.02;
}

bool rayTriangle(vec3 orig, vec3 dir, vec3 v0, vec3 v1, vec3 v2, out float t, out vec3 normal, out float bu, out float bv) {
    vec3 e1 = v1 - v0; vec3 e2 = v2 - v0;
    vec3 pvec = cross(dir, e2);
    float det = dot(e1, pvec);
    if (abs(det) < 1e-7) return false;
    float invDet = 1.0 / det;
    vec3 tvec = orig - v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return false;
    vec3 qvec = cross(tvec, e1);
    float v = dot(dir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) return false;
    t = dot(e2, qvec) * invDet;
    if (t < 1e-4) return false;
    normal = normalize(cross(e1, e2));
    bu = u; bv = v;
    return true;
}

uint RtCellListU16(uint i) { uint w = rtCellListsP[i >> 1]; return (i & 1u) != 0u ? (w >> 16) : (w & 0xFFFFu); }
uint RtCellCount(uint cell) { uint w = rtCellCountsP[cell >> 1]; return (cell & 1u) != 0u ? (w >> 16) : (w & 0xFFFFu); }
uvec2 RtPair(uint w) { uvec4 v = rtGeom4[w >> 2u]; return (w & 2u) != 0u ? v.zw : v.xy; }
vec2 RtUV(uint w) { uvec4 v = rtGeom4[w >> 2u]; return unpackHalf2x16(v[w & 3u]); }
vec3 RtVtxPos(uint vtxBase, uint vi) { uvec2 p = RtPair(vtxBase + vi * 2u); return vec3(unpackHalf2x16(p.x), unpackHalf2x16(p.y).x); }
void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= screenWidth || pixel.y >= screenHeight) return;
    
    vec2 scrSzF = vec2(screenWidth, screenHeight) * float(SSR_RES);
    vec3 worldPos = reconstructWorldPos((vec2(pixel * SSR_RES) + 0.5) / scrSzF);
    if (worldPos == vec3(0.0)) { imageStore(outputImage, ivec2(pixel), vec4(0.0,0.0,0.0,1.0)); return; }
    
    vec4 specColor = imageLoad(inputSpecular, ivec2(pixel * SSR_RES));
    if ((specColor.r + specColor.g + specColor.b) < 0.01) { imageStore(outputImage, ivec2(pixel), vec4(0.0,0.0,0.0,1.0)); return; }
    
    vec2 normalPack = imageLoad(inputNormal, ivec2(pixel * SSR_RES)).rg;
    vec3 normal = DecodeOctahedral(normalPack);
    vec3 viewDir = normalize(camPos - worldPos);
    vec3 reflectDir = reflect(-viewDir, normal);
    vec3 origin = worldPos + normal * 0.05;
    float maxDist = 32.0;
    float bestDist = maxDist + 1.0;
    vec3 hitWorld = vec3(0.0);
    bool hasHit = false;
    vec3 bestNormal = vec3(0.0,1.0,0.0);
    uint bestInst = 0u;
    uint bestUVBase = 0u;
    uint bestIA = 0u, bestIB = 0u, bestIC = 0u;
    float bestBaryU = 0.0, bestBaryV = 0.0;
    const float CELL = 2.56;
    const float CELLXHALF = 1.28;
    int cx = int(floor((origin.x - worldMin.x + CELLXHALF) / CELL));
    int cz = int(floor((origin.z - worldMin.y + CELLXHALF) / CELL));
    cx = clamp(cx, 0, 63);
    cz = clamp(cz, 0, 63);
    int stepX = (reflectDir.x > 0.0) ? 1 : (reflectDir.x < 0.0 ? -1 : 0);
    int stepZ = (reflectDir.z > 0.0) ? 1 : (reflectDir.z < 0.0 ? -1 : 0);
    float tMaxX, tMaxZ, tDeltaX, tDeltaZ;
    if (stepX == 0) { tMaxX = 1e9; tDeltaX = 1e9; }
    else {
        float boundary = (stepX > 0) ? (worldMin.x - CELLXHALF + float(cx + 1) * CELL) : (worldMin.x - CELLXHALF + float(cx) * CELL);
        tMaxX = (boundary - origin.x) / reflectDir.x;
        tDeltaX = CELL / abs(reflectDir.x);
    }
    if (stepZ == 0) { tMaxZ = 1e9; tDeltaZ = 1e9; }
    else { float boundary = (stepZ > 0) ? (worldMin.y - CELLXHALF + float(cz + 1) * CELL) : (worldMin.y - CELLXHALF + float(cz) * CELL); tMaxZ = (boundary - origin.z) / reflectDir.z; tDeltaZ = CELL / abs(reflectDir.z); }
    float t = 0.0;
    for (int iter = 0; iter < 64; ++iter) {
        if (t > maxDist) break;
        if (hasHit && t >= bestDist) break;
        if (cx < 0 || cx >= 64 || cz < 0 || cz >= 64) break;
        
        uint cell = uint(cz * 64 + cx);
            uint cnt = RtCellCount(cell);
            if (cnt > 128u) cnt = 128u;
            for (uint k = 0u; k < cnt; ++k) {
            uint inst = RtCellListU16(cell * 128u + k); if (inst >= 9032u) continue;
            uvec4 instInfo = rtInstanceInfo[inst].info; if (instInfo.y == 0u) continue;
            uvec4 instGeom = rtInstanceInfo[inst].geom;
            vec4 iscl2 = rtInstanceInfo[inst].iscl2;
            mat4 M = modelMatrices[inst];
            vec3 c0 = M[0].xyz; vec3 c1 = M[1].xyz; vec3 c2 = M[2].xyz; vec3 tr = M[3].xyz;
            vec3 rel = origin - tr;
            vec3 localOrigin = vec3(dot(rel, c0) * iscl2.x, dot(rel, c1) * iscl2.y, dot(rel, c2) * iscl2.z),
                 localDir = normalize(vec3(dot(reflectDir, c0) * iscl2.x, dot(reflectDir, c1) * iscl2.y, dot(reflectDir, c2) * iscl2.z));
            vec3 invLocalDir = vec3(localDir.x != 0.0 ? 1.0 / localDir.x : 1e9, localDir.y != 0.0 ? 1.0 / localDir.y : 1e9, localDir.z != 0.0 ? 1.0 / localDir.z : 1e9);
            uint stack[64]; int sp = 0; stack[sp++] = instGeom.x;/*64 deep: an 8-ary BVH needs 1+7*depth slots; 32 silently dropped subtrees past depth 4*/
            uint hitIA = 0u, hitIB = 0u, hitIC = 0u;
            float hitBaryU = 0.0, hitBaryV = 0.0;
            vec3 hitNormal = vec3(0.0,1.0,0.0);
            float bestT = maxDist * sqrt(max(iscl2.x, max(iscl2.y, iscl2.z)));
            bool anyHit = false;
            vec3 hitLocalPoint = vec3(0.0);
            while (sp > 0) {
                uint no = stack[--sp]; if (no == 0xFFFFFFFFu) continue;
                
                uvec4 n0 = rtGeom4[no + 0u];
                uvec4 n1 = rtGeom4[no + 1u];
                vec3 mn = uintBitsToFloat(n0.xyz);
                vec3 mx = uintBitsToFloat(n1.xyz);
                uint triStart = n0.w;
                uint triCount = n1.w;
                float tEntry = rayAABB(localOrigin, invLocalDir, mn, mx, bestT); if (tEntry < 0.0) continue;
                
                if (triCount > 0u) {
                    uint vtxBase = instGeom.z;
                    for (uint triK = 0u; triK < triCount; ++triK) {
                        uvec2 tv = RtPair(triStart + triK * 2u);
                        uint iA = tv.x & 0xFFFFu, iB = (tv.x >> 16) & 0xFFFFu, iC = tv.y & 0xFFFFu;
                        vec3 pa = RtVtxPos(vtxBase, iA);
                        vec3 pb = RtVtxPos(vtxBase, iB);
                        vec3 pc = RtVtxPos(vtxBase, iC);
                        float tt, bu = 0.0, bv = 0.0; vec3 nn; 
                        if (rayTriangle(localOrigin, localDir, pa, pb, pc, tt, nn, bu, bv) && tt < bestT) { bestT = tt; hitLocalPoint = localOrigin + localDir * tt; anyHit = true; hitIA = iA; hitIB = iB; hitIC = iC; hitBaryU = bu; hitBaryV = bv; hitNormal = nn; }
                    }
                } else {
                    uvec4 ch0 = rtGeom4[no + 2u];
                    uvec4 ch1 = rtGeom4[no + 3u];
                    if (sp + 8 <= 64) {
                        for (int c = 0; c < 4; ++c) { uint ch = ch0[c]; if (ch != 0xFFFFFFFFu) stack[sp++] = ch; }
                        for (int c = 0; c < 4; ++c) { uint ch = ch1[c]; if (ch != 0xFFFFFFFFu) stack[sp++] = ch; }
                    }
                }
            }
            if (anyHit) {
                vec3 worldHitPt = (M * vec4(hitLocalPoint, 1.0)).xyz;
                float wd = distance(worldHitPt, worldPos);
                vec3 d = worldHitPt - worldPos;
                float wdSq = dot(d, d);
                if (wdSq > 0.01 && wdSq < bestDist * bestDist) {
                    hasHit = true;
                    bestDist = sqrt(wdSq);
                    hitWorld = worldHitPt;
                    bestInst = inst;
                    bestUVBase = instGeom.w;
                    bestIA = hitIA; bestIB = hitIB; bestIC = hitIC;
                    bestBaryU = hitBaryU; bestBaryV = hitBaryV;
                    bestNormal = normalize((c0 * iscl2.x) * hitNormal.x + (c1 * iscl2.y) * hitNormal.y + (c2 * iscl2.z) * hitNormal.z);
                    if (dot(bestNormal, normalize(camPos - hitWorld)) < 0.0) bestNormal = -bestNormal;
                }
            }
        }
        if (tMaxX < tMaxZ) { cx += stepX; t = tMaxX; tMaxX += tDeltaX; } else { cz += stepZ; t = tMaxZ; tMaxZ += tDeltaZ; }
        if (stepX == 0 && stepZ == 0) break;
    }
    vec3 reflectionColor = vec3(0.0);
    if (hasHit) {
        uint texIdx = rtInstanceInfo[bestInst].info.x;
        if (texIdx < texCount) {
            ivec2 ts = textureSizes[texIdx];
            if (ts.x > 0 && ts.y > 0) {
                vec2 uvHit = vec2(0.0);
                uvHit += RtUV(bestUVBase + bestIA) * (1.0 - bestBaryU - bestBaryV);
                uvHit += RtUV(bestUVBase + bestIB) * bestBaryU;
                uvHit += RtUV(bestUVBase + bestIC) * bestBaryV;
                vec2 uvSample = vec2(uvHit.x, 1.0 - uvHit.y);
                ivec2 tcoord = ivec2(fract(uvSample) * vec2(ts));
                tcoord = clamp(tcoord, ivec2(0,0), ivec2(ts.x - 1, ts.y - 1));
                vec4 albedo = getTextureColor(texIdx, tcoord, ts.x);
                vec3 adjustedNormal = bestNormal;
                vec3 viewDirHit = normalize(camPos - hitWorld);
                vec3 lighting = albedo.rgb * 0.1;
                uint voxelIdx = GetVoxelIndex(hitWorld);
                uint lcount = voxelLightListCounts[voxelIdx];
                if (lcount > 96u) lcount = 96u;/*0 means no lights in this voxel, as in chunk_frag; the old useAll fallback lit reflections from every light in the level, including off and empty slots*/
                for (uint li = 0u; li < lcount; ++li) {
                    uint lightIdx = uniqueLightLists[voxelIdx * 96u + li];
                    vec3 lpos = lights[lightIdx].pos;
                    float intensity = lights[lightIdx].intensity;
                    float range = lights[lightIdx].range;
                    vec3 toLight = lpos - hitWorld;
                    float dist = length(toLight);
                    if (dist >= range || intensity < 0.1) continue;
                    
                    vec3 lightDir = toLight / dist;
                    float NdotL = max(dot(adjustedNormal, lightDir), 0.0);
                    float attenuation = (1.0 - (dist/range)*(dist/range)) * NdotL;
                    if (attenuation < 0.03) continue;
                    
                    float spotAng = lights[lightIdx].spotAng;
                    float spotFalloff = 1.0;
                    if (spotAng > 0.0) {
                        vec4 quat = lights[lightIdx].spotDir;
                        vec3 spotDir = vec3(2.0*(quat.x*quat.z + quat.w*quat.y), 2.0*(quat.y*quat.z - quat.w*quat.x), 1.0 - 2.0*(quat.x*quat.x + quat.y*quat.y));
                        float spotdot = dot(spotDir, -lightDir);
                        float cosAngle = cos(radians(spotAng/2.0));
                        if (spotdot < cosAngle) continue;
                        
                        spotFalloff = smoothstep(cosAngle, cos(radians(spotAng*0.8/2.0)), spotdot);
                        if (spotFalloff <= 0.0) continue;
                    }
                    vec3 baseLighting = albedo.rgb * lights[lightIdx].col * intensity * (attenuation*attenuation/sqrt(sqrt(attenuation)));
                    lighting += baseLighting * spotFalloff;
                    vec3 halfDir = normalize(lightDir + viewDirHit);
                    float ndh = max(dot(adjustedNormal, halfDir), 0.0);
                    float spec = clamp(pow(ndh, 100.0), 0.0, 1.0);
                    lighting += albedo.rgb * intensity * attenuation * spotFalloff * spec * 0.5;
                }
                reflectionColor = lighting;
            }
        }
    }
    vec3 result = reflectionColor * 0.651 * (specColor.rgb + vec3(0.1));
    imageStore(outputImage, ivec2(pixel), vec4(result, 1.0));
}
