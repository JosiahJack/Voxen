// voxels.compute
// Compute shader for determining light lists for voxels and updating voxel tables 
layout(local_size_x = 16, local_size_y = 16) in;
struct Light { vec3 pos; float intensity; vec3 col; uint lflags; float range; float spotAng; float maxIntensity; float minIntensity; vec4 spotDir; };
layout(std430,binding=2) buffer VoxelLightListCounts { uint voxelLightListCounts[]; };
layout(std430,binding=3) buffer UniqueLightLists { uint uniqueLightLists[]; };
layout(std430,binding=4) buffer LightIndices { Light lights[]; };
layout(std430,binding=5) buffer ShadowMaps { uint shadowMaps[]; };
layout(std430,binding=6) buffer ShadowMapsIndirection { uint shadowMapsIndirection[]; };
layout(std430,binding=7) buffer CullingData { uint gridCellStates[]; };
layout(location=0) uniform vec2 voxelMinCenter;
layout(location=1) uniform float farPlaneSqd;
layout(location=2) uniform uint loadedLights;
layout(location=3) uniform vec2 worldMin;
layout(location=4) uniform uint shadowMapSize;
layout(location=5) uniform vec3 camPos;
layout(location=6) uniform uint maxLightsPerVoxel;
const int WORLD_X_VOXELCOUNT = 512;
const float VOXEL_SIZE = 0.32;
const uint SHADON = 2u;
const float vhalf = 0.16;
bool CellVisible(float x, float z){ ivec2 p=ivec2(clamp((vec2(x,z) - worldMin + 1.28)/2.56,0.0,63.0)); return (gridCellStates[p.y*64+p.x]&1)>0; }
bool VoxelOrNeighborVisible(float x, float z) {
    if (CellVisible(x,z)) return true;
    if (CellVisible(x + 1.30,z)) return true;
    if (CellVisible(x - 1.30,z)) return true;
    if (CellVisible(x,z + 1.30)) return true;
    if (CellVisible(x,z - 1.30)) return true;
    return false;
}

void GetCubemapSampleCoord(vec3 toLight, uint shadowIndex, out uint faceOff, out vec2 tc) {
    vec3 a = abs(toLight);
    float mx = step(a.y,a.x) * step(a.z,a.x);
    float my = step(a.x,a.y) * step(a.z,a.y);
    vec3 mxyz = vec3(mx,my,1.0 - mx - my);
    vec3 sxyz = vec3(step(0.0,-toLight.x),step(0.0,-toLight.y),step(0.0,-toLight.z));
    vec3 fxyz = vec3(mix(1.0,0.0,sxyz.x), mix(3.0,2.0,sxyz.y), mix(5.0,4.0,sxyz.z));
    uint face = uint(mxyz.x * fxyz.x + mxyz.y * fxyz.y + mxyz.z * fxyz.z);
    float invMax = 1.0 / max(max(a.x,a.y),a.z);
    vec3 dir = -toLight * invMax;
    vec2 uvx = mix(vec2( dir.z, dir.y), vec2(-dir.z, dir.y), sxyz.x);
    vec2 uvy = mix(vec2( dir.x, dir.z), vec2( dir.x,-dir.z), sxyz.y);
    vec2 uvz = mix(vec2(-dir.x, dir.y), vec2( dir.x, dir.y), sxyz.z);
    float fmx = step(a.y,a.x)*step(a.z,a.x);
    float fmy = step(a.x,a.y)*step(a.z,a.y);
    vec2 uv = fmx * uvx + fmy * uvy + (1.0 - fmx - fmy) * uvz;
    uv = uv * 0.5 + 0.5;
    uint shadSizeSqd = shadowMapSize * shadowMapSize;
    faceOff = (shadowIndex * shadSizeSqd * 6u) + (face * shadSizeSqd);
    tc = uv * float(shadowMapSize);
}

void main() {
    if (gl_GlobalInvocationID.x >= WORLD_X_VOXELCOUNT || gl_GlobalInvocationID.y >= WORLD_X_VOXELCOUNT) return;

    uint voxelIndex = (gl_GlobalInvocationID.y * WORLD_X_VOXELCOUNT) + gl_GlobalInvocationID.x;
    uint baseOffset = voxelIndex * maxLightsPerVoxel;

    float vx = voxelMinCenter.x + float(gl_GlobalInvocationID.x) * VOXEL_SIZE;
    float vz = voxelMinCenter.y + float(gl_GlobalInvocationID.y) * VOXEL_SIZE;
    float vy = 0.0; // adjust if your voxels have varying Y height

    float cdx = vx - camPos.x;
    float cdz = vz - camPos.z;
    if ((cdx*cdx + cdz*cdz) > farPlaneSqd) {
        voxelLightListCounts[voxelIndex] = 0u;
        return;
    }

    if (!VoxelOrNeighborVisible(vx, vz)) {
        voxelLightListCounts[voxelIndex] = 0u;
        return;
    }

    uint count = 0u;
    uint weakestSlot = 0u;
    float weakestScore = 1e38;
    for (uint lightIdx = 0u; lightIdx < loadedLights; ++lightIdx) {
        vec3 lpos = lights[lightIdx].pos;
        float lx = lpos.x;
        float lz = lpos.z;
        float dx = lx - vx;
        float dz = lz - vz;
        float range = lights[lightIdx].range;
        float distSq = dx*dx + dz*dz;
        if (distSq >= range*range) continue;

        float intensity = lights[lightIdx].intensity;
        if (intensity < 0.1) continue;
        if (!CellVisible(lx, lz)) continue;

        if (count < maxLightsPerVoxel) {
            uniqueLightLists[baseOffset + count] = lightIdx;
            if (intensity < weakestScore) {
                weakestScore = intensity;
                weakestSlot = count;
            }
            count++;
        } else if (intensity > weakestScore) {
            uniqueLightLists[baseOffset + weakestSlot] = lightIdx;
            // rescan for new weakest
            weakestScore = intensity;
            for (uint i = 0u; i < maxLightsPerVoxel; ++i) {
                float s = lights[uniqueLightLists[baseOffset + i]].intensity;
                if (s < weakestScore) { weakestScore = s; weakestSlot = i;
                }
            }
        }
    }

    voxelLightListCounts[voxelIndex] = count;
}
