// shadowmaps_clear.compute - Compute shader for clearing the distances for shadowmaps in the SSBO to 0xFFFFFFFF
layout(local_size_x=32, local_size_y=1, local_size_z=1) in;
layout(location=0) uniform uint shadowMapSize;
layout(std430,binding=5) buffer ShadowMaps { uint depthData[]; };
void main() { uint faceSize=shadowMapSize*shadowMapSize; if(gl_GlobalInvocationID.x >= faceSize){return;} depthData[(gl_GlobalInvocationID.z/*light idx*/*faceSize*6) + (gl_WorkGroupID.y/*face idx*/*faceSize) + gl_GlobalInvocationID.x/*pixel*/]=0xFFFFFFFFu; }

