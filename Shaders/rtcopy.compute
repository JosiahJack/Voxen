// rtcopy.compute - Builds the raytracing geometry triangle/position/UV sections for one model entirely on the GPU from that model's already-uploaded render buffers, so raytraced reflections need no CPU-side duplicates.
layout(local_size_x = 256) in;
layout(std430, binding = 18) readonly buffer SrcTris { uint srcWords[]; };
layout(std430, binding = 19) readonly buffer SrcOrder { uint orderWords[]; };
layout(std430, binding = 16) buffer RTGeom { uint rtWords[]; };
layout(location = 3) uniform uint triCount;
layout(location = 4) uniform uint triWordBase;
layout(location = 5) uniform uint orderBase;
uint U16At(uint i) { return (srcWords[i >> 1u] >> ((i & 1u) << 4)) & 0xFFFFu; }
uint OrderAt(uint i) { uint j = orderBase + i; return (orderWords[j >> 1u] >> ((j & 1u) << 4)) & 0xFFFFu; }
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < triCount) { uint t = OrderAt(i) * 3u; rtWords[triWordBase + i * 2u] = U16At(t) | (U16At(t + 1u) << 16); rtWords[triWordBase + i * 2u + 1u] = U16At(t + 2u); }
}
