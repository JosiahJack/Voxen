// ssr.compute - Compute shader for Screen Space Reflections 
layout(local_size_x = 32, local_size_y = 32) in;
layout(rgba8,  binding=0) readonly uniform image2D inputImage;
layout(rgba32f,binding=1) readonly uniform image2D inputWorldPos;
layout(rgba8,  binding=2) readonly uniform image2D inputSpecular;
layout(rgba8,  binding=4) uniform image2D outputImage;
layout(rg16f,  binding=5) readonly uniform image2D inputNormal;
layout(location=0) uniform uint screenWidth;
layout(location=1) uniform uint screenHeight;
layout(location=2) uniform int SSR_RES;
layout(location=3) uniform vec3 camPos;
layout(location=4) uniform mat4 viewProjection;
layout(location=5) uniform sampler2D inputDepthID;
layout(location=6) uniform mat4 invViewProj; /*
layout(location=7) some weird
layout(location=8) padding apparently, so say some docs anyhow
layout(location=9) */
vec3 DecodeOctahedral(vec2 enc) {
    enc = enc * 2.0 - 1.0;
    vec3 n = vec3(enc, 1.0 - abs(enc.x) - abs(enc.y));
    float t = max(-n.z, 0.0);
    n.xy -= t * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return normalize(n);
}

vec3 reconstructWorldPos(vec2 uv) {
    float depth = texture(inputDepthID, uv).r;
    if (depth >= 0.9999) return vec3(0.0); // invalid
    vec4 clip = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 world = invViewProj * clip;
    return world.xyz / world.w;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= screenWidth || pixel.y >= screenHeight) return;

    vec4 worldPosPack = imageLoad(inputWorldPos,ivec2(pixel * SSR_RES));
    vec3 worldPos = worldPosPack.xyz;
//     vec3 worldPos = reconstructWorldPos(ivec2(pixel * SSR_RES));
//     if (worldPos == vec3(0.0)) return;

    vec4 specColor = imageLoad(inputSpecular,ivec2(pixel * SSR_RES));
    if ((specColor.r + specColor.g + specColor.b) < 0.01) return;
    
    vec2 normalPack = imageLoad(inputNormal,ivec2(pixel * SSR_RES)).rg;
    vec3 normal = DecodeOctahedral(normalPack);
    vec3 viewDir = normalize(camPos - worldPos);
    vec3 reflectDir = reflect(-viewDir,normal);
    float cosTheta = max(dot(-viewDir,normal),0.0);
    vec2 hitUV = vec2(0.0);
    vec3 reflectionColor = vec3(0.0);
    float totalWeight = 0.0;
    vec3 marchPos = worldPos + normal * 0.005;
    vec3 rayStep = reflectDir * 0.55; // stepSize
    vec2 screenSize = vec2(screenWidth,screenHeight);
    ivec2 screenSizeLess1 = ivec2(screenWidth - 1,screenHeight - 1);
    ivec2 zeroIVec2 = ivec2(0,0);
    for (int i=0;i<48;++i) { // stepCount
        marchPos += rayStep;
        vec4 clipPos = viewProjection * vec4(marchPos, 1.0);
        vec2 ndc = clipPos.xy / clipPos.w;
        hitUV = ndc * 0.5 + 0.5;
        if (hitUV.x <= 0.01 || hitUV.x >= 0.99 || hitUV.y <= 0.01 || hitUV.y >= 0.99) break;

        ivec2 samplePixel = ivec2(hitUV * screenSize);
        samplePixel = clamp(samplePixel,zeroIVec2,screenSizeLess1);
        vec4 sampledWorldPosPack = imageLoad(inputWorldPos,samplePixel * SSR_RES);
        vec3 sampledWorldPos = sampledWorldPosPack.xyz;
//         vec3 sampledWorldPos = reconstructWorldPos(samplePixel * SSR_RES);
//         if (sampledWorldPos == vec3(0.0)) continue;

        vec2 sampledNormalPack = imageLoad(inputNormal,ivec2(samplePixel * SSR_RES)).rg;
        vec3 sampledNormal = -DecodeOctahedral(sampledNormalPack);
        if (dot(reflectDir, sampledNormal) >= 0.0) continue;
        
        vec3 sampDelta = marchPos - sampledWorldPos;
        float dist2 = dot(sampDelta,sampDelta);
        float weight = exp(-dist2 / 2.15);
        if (weight > 0.01) { // Minimum weight threshold
            vec4 sampleColor = imageLoad(inputImage,samplePixel * SSR_RES);
            reflectionColor += sampleColor.rgb * weight;
            totalWeight += weight;
            if (totalWeight > 0.8) break;
        }
    }

    reflectionColor /= totalWeight; // Normalize by total weight
    vec3 result = reflectionColor * 0.651 * (specColor.rgb + vec3(0.1,0.1,0.1));
    imageStore(outputImage,ivec2(pixel),vec4(result, 1.0));
}
